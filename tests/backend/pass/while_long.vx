//===----------------------------------------------------------------------===//
// A million passes through a `while` whose body declares a local. The loop must
// not grow the stack on each pass, and a `let` in the body is a fresh variable
// every time: it starts again from its initial value rather than carrying over.
//
// The legacy AST codegen places the local's `memref.alloca` inside the loop
// body, so each pass takes a new stack slot and the program overflows the stack.
//
// REQUIRES: flat-codegen

fn main() -> i32 {
  let mut i : i32 = 0;
  let mut total : i32 = 0;
  while i < 1000000 {
    i = i + 1;
    let mut fresh : i32 = 3;
    fresh = fresh + 1;
    total = total + fresh;
  }
  print!("i=");
  print!(i);
  print!(",total=");
  print!(total);
  print!(";");
  return 0;
}

// EXPECT: i=1000000,total=4000000;
