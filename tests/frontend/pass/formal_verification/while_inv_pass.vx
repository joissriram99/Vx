// A `while` takes `invariant` clauses after its condition, with or without
// parentheses, and an invariant the `requires` clause establishes is accepted.

fn test_while_increment(N : i32) -> i32
requires N == 0
ensures return == 0 {
  let mut i : i32 = 0;
  while i < 10 invariant N == 0 {
    i = i + 1;
  }
  return N;
}

fn test_while_range(N : i32) -> i32
requires N > 5 && N < 15 ensures return > 5
{
  let mut i : i32 = 0;
  while i < 5 invariant(N > 5) invariant(N < 15) {
    i = i + 1;
  }
  return N;
}

fn main() -> i32 {
  return 0;
}
